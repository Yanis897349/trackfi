{
  "name": "@trackfi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm i18n:compile && vite build",
    "build:functions": "pnpm i18n:compile && wrangler pages functions build functions --outdir .wrangler/functions --compatibility-date=2026-08-12 --compatibility-flag=nodejs_compat",
    "deploy": "wrangler pages deploy dist",
    "dev": "pnpm i18n:compile && vite --host 0.0.0.0 --port ${WEB_PORT:-5173}",
    "i18n:compile": "node scripts/compile-localization.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "pnpm i18n:compile && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm i18n:compile && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-table": "^8.21.3",
    "@trackfi/localization": "workspace:*",
    "@trackfi/ui": "workspace:*",
    "better-auth": "^1.6.26",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "3.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-plugin": "^1.168.29",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@trackfi/eslint-config": "workspace:*",
    "@trackfi/typescript-config": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.0.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
