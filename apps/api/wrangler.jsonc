{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackfi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://trackfi-web.pages.dev",
    "AUTH_BASE_URL": "https://trackfi-api.trackfi-api.workers.dev",
    "EMAIL_FROM": "Trackfi <hello@yanis-kernoua.dev>",
    "ADMIN_EMAILS": "trackfi-web.pages.de.contend323@passmail.net",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BRANDFETCH_CLIENT_ID",
      "RESEND_API_KEY",
      "TURNSTILE_SECRET_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackfi-db",
      "database_id": "35ee22b5-b481-4b22-a708-85aa8ccc1cec",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
