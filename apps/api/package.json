{
  "name": "@trackfi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port ${API_PORT:-8787}",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@trackfi/eslint-config": "workspace:*",
    "@trackfi/typescript-config": "workspace:*",
    "@types/node": "^24.10.0",
    "eslint": "^10.0.2",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
